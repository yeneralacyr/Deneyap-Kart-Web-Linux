# Deneyap kartlar icin seri port izni (CP210x / CH340 / USB ACM).
# Kurulum: sudo cp 99-deneyap.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="uucp", SYMLINK+="deneyap%n"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", GROUP="uucp", SYMLINK+="deneyap%n"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666", GROUP="uucp"
KERNEL=="ttyUSB[0-9]*", MODE="0666", GROUP="uucp"
KERNEL=="ttyACM[0-9]*", MODE="0666", GROUP="uucp"
